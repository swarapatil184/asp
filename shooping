<h2>Shopping Cart</h2>

<table class="table table-bordered">
    <tr>
        <th>Product</th>
        <th>Price</th>
        <th>Quantity</th>
        <th>Total</th>
        <th>Action</th>
    </tr>
    @foreach (var item in Model)
    {
        <tr>
            <td>@item.Product.ProductName</td>
            <td>@item.Product.Price</td>
            <td>@item.Quantity</td>
            <td>@(item.Product.Price * item.Quantity)</td>
            <td>@Html.ActionLink("Remove", "Remove", new { id = item.Product.ProductID })</td>
        </tr>
    }
    <tr>
        <td colspan="3"><b>Grand Total</b></td>
        <td colspan="2"><b>@Model.Sum(x => x.Product.Price * x.Quantity)</b></td>
    </tr>
</table>

